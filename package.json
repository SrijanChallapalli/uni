{
  "name": "errand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "cd contracts && forge test",
    "db:start": "supabase start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,postgres-meta,supavisor,mailpit",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed.ts",
    "stream:relay": "tsx --env-file=.env.local --conditions=react-server scripts/local-stream-relay.ts",
    "contracts:build": "cd contracts && forge build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
