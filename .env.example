# ---------- Database & auth (Supabase). Local values come from `npx supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Demo mode (fictional personas + reset). Never enable on a real deployment.
DEMO_MODE=true
DEMO_COOKIE_SECRET=change-me-to-32-random-chars
# ---------- Server secrets
HANDOFF_SECRET=change-me-to-32-random-chars
OPS_TOKEN=change-me-to-32-random-chars

# ---------- Agents. Without a key, a clearly labeled rules-based agent is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_MODE=rules   # force the rules agent even when a key is set

# ---------- Escrow: "simulated" (reproducible demo) or "arc_testnet" (real test USDC on Arc Testnet)
ESCROW_MODE=simulated
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_CONTRACT_ADDRESS=
ESCROW_DEPLOY_BLOCK=0
# Test-only keys. Server-side only; never prefix with NEXT_PUBLIC_.
PLATFORM_SIGNER_KEY=
RESOLVER_KEY=

# ---------- QuickNode Streams (webhook destination: https://<host>/api/streams/quicknode)
QUICKNODE_STREAM_SECRET=
# Local, labeled simulated stream relay (scripts/local-stream-relay.ts). Off in production.
ALLOW_SIMULATED_STREAM=false
SIMULATED_STREAM_SECRET=
